{
  "name": "uc-rendezvous",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:web": "node tests/web-pairings.e2e.cjs",
    "dev:web": "wrangler dev --local --ip 127.0.0.1 --inspector-port 0 --var WEB_PAIRING_ENV:development",
