    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.0"
  }
}
